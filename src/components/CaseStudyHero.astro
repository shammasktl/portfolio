---
import type { CaseStudy } from "../data/caseStudies";

interface Props {
  caseStudy: CaseStudy;
}

const { caseStudy } = Astro.props;
---

<header class="pt-8 md:pt-14 pb-12 md:pb-16 bg-surface border-b border-outline-variant/60">
  <div class="max-w-[var(--spacing-container-max)] mx-auto px-[var(--spacing-margin-mobile)] md:px-[var(--spacing-margin-desktop)]">
    
    <!-- Breadcrumb Bar -->
    <nav aria-label="Breadcrumb" class="mb-6 sm:mb-8 flex items-center gap-2 text-[12px] sm:text-[13px] font-medium font-plus-jakarta-sans text-secondary">
      <a href="/" class="hover:text-primary transition-colors">Home</a>
      <span class="text-outline-variant">/</span>
      <a href="/work/" class="hover:text-primary transition-colors">Work</a>
      <span class="text-outline-variant">/</span>
      <span class="text-primary font-semibold truncate max-w-[180px] sm:max-w-xs">{caseStudy.title}</span>
    </nav>

    <!-- Top Badge & Header -->
    <div class="max-w-4xl scroll-reveal">
      <div class="inline-flex items-center gap-2 font-plus-jakarta-sans text-[11px] tracking-[0.15em] font-bold text-on-primary bg-primary py-1 px-3 mb-6 rounded-sm uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        {caseStudy.categoryLabel}
      </div>

      <h1 class="font-plus-jakarta-sans font-extrabold text-primary text-[34px] sm:text-[48px] md:text-[60px] lg:text-[68px] leading-[1.08] tracking-tight uppercase mb-6">
        {caseStudy.title}
      </h1>

      <p class="font-plus-jakarta-sans text-[17px] sm:text-[20px] md:text-[22px] text-secondary leading-relaxed font-normal mb-10 max-w-3xl">
        {caseStudy.summary}
      </p>
    </div>

    <!-- Metadata Grid & Links -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 py-6 px-6 sm:px-8 bg-surface-container-lowest rounded-xl border border-outline-variant/80 shadow-sm mb-10 scroll-reveal">
      <div>
        <span class="block text-[11px] font-bold uppercase tracking-wider text-secondary mb-1 font-plus-jakarta-sans">Client</span>
        <span class="text-[14px] sm:text-[15px] font-semibold text-primary font-plus-jakarta-sans">{caseStudy.client}</span>
      </div>

      <div>
        <span class="block text-[11px] font-bold uppercase tracking-wider text-secondary mb-1 font-plus-jakarta-sans">Timeline</span>
        <span class="text-[14px] sm:text-[15px] font-semibold text-primary font-plus-jakarta-sans">{caseStudy.timeline}</span>
      </div>

      <div>
        <span class="block text-[11px] font-bold uppercase tracking-wider text-secondary mb-1 font-plus-jakarta-sans">Role</span>
        <span class="text-[14px] sm:text-[15px] font-semibold text-primary font-plus-jakarta-sans">{caseStudy.role}</span>
      </div>

      <div class="flex flex-col justify-center gap-2">
        <span class="block text-[11px] font-bold uppercase tracking-wider text-secondary font-plus-jakarta-sans">Links & Deliverables</span>
        <div class="flex flex-wrap items-center gap-3">
          {caseStudy.liveUrl && (
            <a
              href={caseStudy.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-[12px] font-bold text-primary bg-surface-container-high hover:bg-primary hover:text-on-primary px-3 py-1.5 rounded transition-all duration-200"
            >
              <span>Live Site</span>
              <span class="material-symbols-outlined text-[14px]" aria-hidden="true">open_in_new</span>
            </a>
          )}
          {caseStudy.githubUrl && (
            <a
              href={caseStudy.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-[12px] font-bold text-primary bg-surface-container-high hover:bg-primary hover:text-on-primary px-3 py-1.5 rounded transition-all duration-200"
            >
              <span>Code Repo</span>
              <span class="material-symbols-outlined text-[14px]" aria-hidden="true">code</span>
            </a>
          )}
          {!caseStudy.liveUrl && !caseStudy.githubUrl && (
            <span class="text-[12px] font-medium text-outline italic">Enterprise Protected</span>
          )}
        </div>
      </div>
    </div>

    <!-- Main Visual Hero Image -->
    <div class="relative w-full aspect-[16/9] sm:aspect-[21/9] rounded-2xl overflow-hidden bg-surface-container-high border border-outline-variant shadow-xl group scroll-reveal">
      <img
        src={caseStudy.heroImage}
        alt={caseStudy.heroImageAlt}
        loading="eager"
        decoding="async"
        class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-70"></div>
      
      <!-- Subtitle Badge Overlay -->
      <div class="absolute bottom-6 left-6 right-6 flex items-end justify-between gap-4">
        <div class="bg-background/90 backdrop-blur-md px-4 py-2.5 rounded-lg border border-outline-variant/80 max-w-lg shadow-lg">
          <span class="text-[10px] font-bold tracking-widest text-secondary uppercase block font-plus-jakarta-sans">Case Study Focus</span>
          <span class="text-[15px] sm:text-[17px] font-extrabold text-primary font-plus-jakarta-sans">{caseStudy.subtitle}</span>
        </div>
      </div>
    </div>

  </div>
</header>
