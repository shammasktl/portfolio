---
/**
 * JourneyTimeline — Career journey & background timeline component.
 * Typed timeline entries with sticky header layout.
 */

export interface TimelineItem {
  period:      string;
  title:       string;
  description: string;
  isCurrent?:  boolean;
}

export interface Props {
  heading?: string;
  items?:   TimelineItem[];
}

const defaultItems: TimelineItem[] = [
  {
    period:      "2023 — PRESENT",
    title:       "Fullstack Developer",
    description: "Expanded beyond the frontend to architect complete end-to-end systems — building RESTful and GraphQL APIs, designing database schemas, and deploying production applications. Currently engineering fullstack platforms that serve real users at scale.",
    isCurrent:   true,
  },
  {
    period:      "2021 — 2023",
    title:       "Frontend Developer",
    description: "Transitioned from learner to builder — crafting pixel-perfect, performant UIs with React, TypeScript, and modern CSS. Developed a sharp eye for design systems, accessibility, and component-driven architecture.",
  },
  {
    period:      "2022 — PRESENT",
    title:       "BCA — Manipal University",
    description: "Pursuing a Bachelor of Computer Applications at Manipal University, deepening the theoretical foundations that complement hands-on engineering work — data structures, algorithms, software engineering, and systems design.",
  },
  {
    period:      "2019 — 2021",
    title:       "Student — Darul Huda Islamic University",
    description: "Where the journey began. Studied at Darul Huda Islamic University, building discipline, focus, and a structured approach to learning — qualities that later shaped the way I think about software and problem solving.",
  },
];

const {
  heading = "The Journey",
  items   = defaultItems,
} = Astro.props;
---

<section class="py-[var(--spacing-section-padding)] bg-surface-container-low">
  <div class="px-[var(--spacing-margin-mobile)] md:px-[var(--spacing-margin-desktop)] max-w-[var(--spacing-container-max)] mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-[var(--spacing-gutter)]">

      <!-- Sticky Section Header -->
      <div class="md:col-span-4 scroll-reveal">
        <h2 class="font-plus-jakarta-sans font-semibold text-primary text-[32px] md:text-[48px] leading-tight sticky top-32">
          {heading}
        </h2>
      </div>

      <!-- Timeline Content -->
      <div class="md:col-span-8 space-y-16 scroll-stagger">
        {items.map((item) => (
          <div class="scroll-stagger-item border-l-2 border-outline-variant pl-8 relative">
            <!-- Timeline Indicator Node -->
            <div
              class={[
                "absolute w-4 h-4 left-[-9px] top-0",
                item.isCurrent ? "bg-primary" : "bg-outline-variant",
              ].join(" ")}
              aria-hidden="true"
            ></div>

            <span class="font-plus-jakarta-sans text-[12px] tracking-[0.1em] font-bold text-secondary block mb-2 uppercase">
              {item.period}
            </span>
            <h3 class="font-plus-jakarta-sans font-semibold text-[24px] md:text-[32px] text-primary mb-4 leading-tight">
              {item.title}
            </h3>
            <p class="font-plus-jakarta-sans text-[16px] leading-relaxed text-on-surface-variant">
              {item.description}
            </p>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
