---
import type { CaseStudy } from "../data/caseStudies";

interface Props {
  prev?: CaseStudy;
  next?: CaseStudy;
}

const { prev, next } = Astro.props;
---

<nav aria-label="Case Study Pagination" class="py-16 md:py-20 bg-surface-container-low border-t border-outline-variant/60">
  <div class="max-w-[var(--spacing-container-max)] mx-auto px-[var(--spacing-margin-mobile)] md:px-[var(--spacing-margin-desktop)]">
    
    <div class="flex items-center justify-between gap-4 mb-8">
      <span class="font-plus-jakarta-sans text-[11px] font-bold tracking-widest text-secondary uppercase bg-surface-container-high px-3 py-1 rounded">
        PROJECT NAVIGATION
      </span>
      <a href="/work/" class="font-plus-jakarta-sans text-[13px] font-bold text-primary uppercase tracking-wider hover:text-tertiary transition-colors flex items-center gap-1.5">
        <span>View Full Gallery</span>
        <span class="material-symbols-outlined text-[16px]">grid_view</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
      
      <!-- Previous Project Card -->
      {prev ? (
        <a
          href={`/work/${prev.slug}/`}
          class="group p-6 sm:p-8 rounded-xl bg-surface-container-lowest border border-outline-variant shadow-sm hover:border-primary hover:shadow-lg transition-all duration-300 flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center gap-2 text-[11px] font-bold tracking-widest uppercase text-secondary mb-3 font-plus-jakarta-sans">
              <span class="material-symbols-outlined text-[16px] group-hover:-translate-x-1 transition-transform">arrow_back</span>
              <span>Previous Intervention</span>
            </div>
            <h3 class="font-plus-jakarta-sans font-bold text-[20px] sm:text-[24px] text-primary group-hover:text-tertiary transition-colors leading-snug mb-2">
              {prev.title}
            </h3>
            <p class="font-plus-jakarta-sans text-[13px] text-on-surface-variant line-clamp-2">
              {prev.summary}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-outline-variant/50 flex items-center justify-between">
            <span class="font-plus-jakarta-sans text-[11px] font-bold uppercase text-outline">
              {prev.categoryLabel}
            </span>
            <span class="font-plus-jakarta-sans text-[12px] font-bold text-primary group-hover:underline">Read Case Study →</span>
          </div>
        </a>
      ) : (
        <div class="p-6 sm:p-8 rounded-xl bg-surface-container/50 border border-outline-variant/40 flex items-center justify-center text-outline font-plus-jakarta-sans text-[13px]">
          Beginning of Selected Works
        </div>
      )}

      <!-- Next Project Card -->
      {next ? (
        <a
          href={`/work/${next.slug}/`}
          class="group p-6 sm:p-8 rounded-xl bg-surface-container-lowest border border-outline-variant shadow-sm hover:border-primary hover:shadow-lg transition-all duration-300 flex flex-col justify-between text-right"
        >
          <div>
            <div class="flex items-center justify-end gap-2 text-[11px] font-bold tracking-widest uppercase text-secondary mb-3 font-plus-jakarta-sans">
              <span>Next Intervention</span>
              <span class="material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
            </div>
            <h3 class="font-plus-jakarta-sans font-bold text-[20px] sm:text-[24px] text-primary group-hover:text-tertiary transition-colors leading-snug mb-2">
              {next.title}
            </h3>
            <p class="font-plus-jakarta-sans text-[13px] text-on-surface-variant line-clamp-2">
              {next.summary}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-outline-variant/50 flex items-center justify-between">
            <span class="font-plus-jakarta-sans text-[12px] font-bold text-primary group-hover:underline">Read Case Study →</span>
            <span class="font-plus-jakarta-sans text-[11px] font-bold uppercase text-outline">
              {next.categoryLabel}
            </span>
          </div>
        </a>
      ) : (
        <div class="p-6 sm:p-8 rounded-xl bg-surface-container/50 border border-outline-variant/40 flex items-center justify-center text-outline font-plus-jakarta-sans text-[13px]">
          End of Selected Works
        </div>
      )}

    </div>
  </div>
</nav>
