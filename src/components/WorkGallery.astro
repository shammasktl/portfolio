---
/**
 * WorkGallery — Modern Editorial Bento Grid Gallery & Project Template Section.
 * Dynamically rendered from src/data/projects.json via caseStudies.ts.
 */
import { caseStudies } from "../data/caseStudies";

export interface BentoProject {
  id:           string;
  title:        string;
  subtitle:     string;
  category:     'ux' | 'dev' | 'branding';
  tags:         string[];
  imageUrl:     string;
  imageAlt:     string;
  description:  string;
  metrics?:     { label: string; value: string };
  href:         string;
  colSpan:      string;
  isFeatured?:  boolean;
  date?:        string;
}

const bentoProjects: BentoProject[] = caseStudies.map((cs, index) => {
  const isLargeHero = index === 0;
  return {
    id:          cs.slug,
    title:       cs.title,
    subtitle:    cs.subtitle,
    category:    cs.category || 'ux',
    tags:        cs.architecture?.techStack?.map(t => t.name).slice(0, 4) || [cs.categoryLabel],
    imageUrl:    cs.heroImage,
    imageAlt:    cs.heroImageAlt || cs.title,
    description: cs.summary,
    metrics:     cs.metrics && cs.metrics.length > 0 ? { label: cs.metrics[0].label, value: cs.metrics[0].value } : undefined,
    href:        `/work/${cs.slug}/`,
    colSpan:     isLargeHero ? "col-span-1 md:col-span-2 lg:col-span-8" : "col-span-1 md:col-span-1 lg:col-span-4",
    isFeatured:  index === 0,
    date:        cs.timeline,
  };
});

const allCategoriesConfig = [
  { id: 'ux', label: 'UX & Product' },
  { id: 'dev', label: 'Engineering & Systems' },
  { id: 'branding', label: 'Brand Strategy' },
] as const;

// Only display category filter tabs that have at least 1 project in the dataset
const usedCategories = allCategoriesConfig.filter((cat) =>
  bentoProjects.some((p) => p.category === cat.id)
);
---

<section 
  id="work-gallery"
  class="py-16 md:py-24 lg:py-32 bg-surface text-on-surface transition-colors duration-300"
  aria-labelledby="gallery-heading"
>
  <div class="max-w-[var(--spacing-container-max)] mx-auto px-[var(--spacing-margin-mobile)] md:px-[var(--spacing-margin-desktop)]">

    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 sm:mb-16 md:mb-20 scroll-reveal">
      <div>
        <span class="font-plus-jakarta-sans text-[11px] sm:text-[12px] tracking-[0.15em] font-bold text-secondary uppercase bg-surface-container px-3 py-1 rounded">
          Portfolio & Case Studies
        </span>
        <h2 
          id="gallery-heading" 
          class="font-plus-jakarta-sans font-extrabold text-primary mt-3 text-[32px] sm:text-[42px] md:text-[56px] leading-[1.1] tracking-tight uppercase"
        >
          Selected Works
        </h2>
      </div>
      <p class="font-plus-jakarta-sans text-on-surface-variant max-w-md text-[15px] sm:text-[16px] leading-relaxed">
        A curated collection of digital architecture, user experience transformations, and high-impact interventions.
      </p>
    </div>

    <!-- Filter Buttons (Only shown for used categories) -->
    <div class="flex flex-wrap items-center gap-2 sm:gap-3 mb-10 sm:mb-14 scroll-reveal" role="tablist" aria-label="Filter projects by category">
      <button
        type="button"
        class="filter-btn active bg-primary text-on-primary font-plus-jakarta-sans text-[13px] font-bold px-4 sm:px-5 py-2.5 rounded-full transition-all duration-200 shadow-sm"
        data-filter="all"
        role="tab"
        aria-selected="true"
      >
        All Works ({bentoProjects.length})
      </button>
      {usedCategories.map((cat) => {
        const count = bentoProjects.filter((p) => p.category === cat.id).length;
        return (
          <button
            type="button"
            class="filter-btn bg-surface-container-high text-on-surface-variant hover:text-primary font-plus-jakarta-sans text-[13px] font-bold px-4 sm:px-5 py-2.5 rounded-full transition-all duration-200"
            data-filter={cat.id}
            role="tab"
            aria-selected="false"
          >
            {cat.label} ({count})
          </button>
        );
      })}
    </div>

    <!-- Bento Grid Container -->
    <div id="bento-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-6 sm:gap-8">
      {bentoProjects.map((project) => (
        <article 
          class={[
            "bento-item group relative bg-surface-container-low rounded-2xl overflow-hidden border border-outline-variant/60 hover:border-outline transition-all duration-500 hover:shadow-2xl flex flex-col justify-between scroll-reveal",
            project.colSpan,
          ].join(" ")}
          data-category={project.category}
        >
          <!-- Card Header & Metadata -->
          <div class="p-6 sm:p-8 lg:p-10 z-10">
            <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
              <span class="font-plus-jakarta-sans text-[11px] tracking-[0.15em] font-bold text-tertiary uppercase bg-surface-container px-3 py-1 rounded-sm">
                {project.subtitle}
              </span>
              {project.date && (
                <span class="font-plus-jakarta-sans text-[12px] font-medium text-outline">
                  {project.date}
                </span>
              )}
            </div>

            <h3 class="font-plus-jakarta-sans font-bold text-primary text-[24px] sm:text-[28px] lg:text-[34px] leading-tight mb-3 group-hover:text-primary-container transition-colors">
              <a href={project.href} class="focus:outline-none focus:underline">
                <span class="absolute inset-0" aria-hidden="true"></span>
                {project.title}
              </a>
            </h3>

            <p class="font-plus-jakarta-sans text-on-surface-variant text-[14px] sm:text-[15px] leading-relaxed max-w-2xl mb-6">
              {project.description}
            </p>

            <!-- Tags -->
            <div class="flex flex-wrap gap-2 mb-6">
              {project.tags.map((tag) => (
                <span class="font-plus-jakarta-sans text-[11px] font-semibold text-on-surface-variant bg-surface-container-high px-2.5 py-1 rounded-md">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Image & Metric Banner Container -->
          <div class="relative w-full overflow-hidden aspect-[16/10] sm:aspect-[21/9] lg:aspect-[16/9] bg-surface-container-high">
            <div 
              class="w-full h-full bg-cover bg-center transition-transform duration-700 ease-out group-hover:scale-105"
              style={`background-image: url('${project.imageUrl}');`}
              role="img"
              aria-label={project.imageAlt}
            ></div>
            <div class="absolute inset-0 bg-gradient-to-t from-surface-container-low via-surface-container-low/20 to-transparent opacity-80 group-hover:opacity-60 transition-opacity"></div>

            <!-- Optional Metric Badge -->
            {project.metrics && (
              <div class="absolute bottom-4 right-4 sm:bottom-6 sm:right-6 bg-surface-container/90 backdrop-blur-md border border-outline-variant/80 px-4 py-2.5 rounded-xl shadow-lg z-10 flex items-center gap-3">
                <span class="font-plus-jakarta-sans text-[11px] font-bold text-outline uppercase tracking-wider">
                  {project.metrics.label}
                </span>
                <span class="font-plus-jakarta-sans text-[18px] sm:text-[20px] font-extrabold text-primary">
                  {project.metrics.value}
                </span>
              </div>
            )}

            <!-- CTA Arrow Indicator -->
            <div class="absolute bottom-4 left-4 sm:bottom-6 sm:left-6 z-10">
              <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-primary text-on-primary shadow-md group-hover:scale-110 group-hover:bg-primary-container transition-all">
                <span class="material-symbols-outlined text-[20px]" aria-hidden="true">arrow_outward</span>
              </span>
            </div>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<!-- Filter Interactivity Script -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const bentoItems = document.querySelectorAll<HTMLElement>(".bento-item");

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.getAttribute("data-filter");

        // Toggle active states on tabs
        filterBtns.forEach((b) => {
          b.classList.remove("active", "bg-primary", "text-on-primary");
          b.classList.add("bg-surface-container-high", "text-on-surface-variant");
          b.setAttribute("aria-selected", "false");
        });

        btn.classList.add("active", "bg-primary", "text-on-primary");
        btn.classList.remove("bg-surface-container-high", "text-on-surface-variant");
        btn.setAttribute("aria-selected", "true");

        // Filter items
        bentoItems.forEach((item) => {
          const category = item.getAttribute("data-category");
          if (filter === "all" || category === filter) {
            item.style.display = "flex";
            item.style.opacity = "1";
          } else {
            item.style.display = "none";
            item.style.opacity = "0";
          }
        });
      });
    });
  });
</script>
