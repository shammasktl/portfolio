---
import type { MetricItem } from "../data/caseStudies";

interface Props {
  metrics: MetricItem[];
}

const { metrics } = Astro.props;
---

{metrics && metrics.length > 0 && (
  <section class="py-12 md:py-16 bg-surface-container-low border-b border-outline-variant/60" aria-label="Project Key Impact Metrics">
    <div class="max-w-[var(--spacing-container-max)] mx-auto px-[var(--spacing-margin-mobile)] md:px-[var(--spacing-margin-desktop)]">
      
      <div class="flex items-center gap-3 mb-8 scroll-reveal">
        <span class="font-plus-jakarta-sans text-[11px] font-bold tracking-widest text-secondary uppercase bg-surface-container-high px-3 py-1 rounded">
          KEY RESULTS
        </span>
        <h2 class="font-plus-jakarta-sans text-[18px] sm:text-[22px] font-extrabold text-primary uppercase">
          Quantified Impact & ROI
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 scroll-stagger">
        {metrics.map((m) => (
          <div class="bento-item p-6 rounded-xl bg-surface-container-lowest border border-outline-variant shadow-sm hover:border-primary/40 hover:shadow-md transition-all duration-300 flex flex-col justify-between scroll-stagger-item">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="font-plus-jakarta-sans text-[11px] font-bold tracking-wider text-secondary uppercase">
                  {m.label}
                </span>
                {m.change && (
                  <span class="font-plus-jakarta-sans text-[11px] font-extrabold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-full">
                    {m.change}
                  </span>
                )}
              </div>
              <div class="font-plus-jakarta-sans font-black text-[36px] sm:text-[42px] text-primary leading-tight mb-2">
                {m.value}
              </div>
            </div>
            {m.description && (
              <p class="font-plus-jakarta-sans text-[13px] text-on-surface-variant leading-relaxed pt-3 border-t border-outline-variant/50">
                {m.description}
              </p>
            )}
          </div>
        ))}
      </div>

    </div>
  </section>
)}
